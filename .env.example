APP_NAME=FinBoard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL Database Configuration (matching docker-compose.yml)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=finboard
DB_USERNAME=finboard_user
DB_PASSWORD=finboard_secret

# Session & Cache configuration using Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=finboard_cache

# Redis Configuration (phpredis extension inside Docker)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
# Local Development: uses Mailpit in Docker (port 1025)
# Production (Oracle Cloud / OCI): Port 25 is blocked by default!
# Always use Port 587 (TLS) or Port 465 (SSL) for production SMTP delivery.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_ENCRYPTION=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="no-reply@finboard.local"
MAIL_FROM_NAME="${APP_NAME}"

# Production SMTP Example (e.g. mail.helvest.pl / Transactional Mailer):
# MAIL_MAILER=smtp
# MAIL_HOST=mail.helvest.pl
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=advisory@helvest.pl
# MAIL_PASSWORD="your-strong-smtp-password"
# MAIL_TIMEOUT=15
# MAIL_FROM_ADDRESS="advisory@helvest.pl"
# MAIL_FROM_NAME="FinBoard Advisory"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Virtual Data Room (VDR) Physical Encryption at Rest (AES-256-GCM)
# Generate a cryptographically secure key with: php artisan vdr:key-generate
# Fallback: if VDR_ENCRYPTION_KEY is unset, a key derived from APP_KEY via HKDF-SHA256 is used with a log warning.
VDR_ENCRYPTION_ENABLED=true
VDR_ENCRYPTION_ALGO=aes-256-gcm
VDR_ENCRYPTION_KEY=
VDR_ACTIVE_KEY_ID=vdr-key-1

VITE_APP_NAME="${APP_NAME}"

# Docker Port Mapping & User ID Configuration
FORWARD_HTTP_PORT=8080
FORWARD_PG_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
DOCKER_UID=1000
DOCKER_GID=1000
